      "section": {
        "id": "section-5",
        "title": "二次函数的性质：最值与单调性",
        "contentType": "explanation",
        "depth": "intermediate",
        "knowledgePoints": [
          "最值",
          "单调性",
          "与一元二次方程关系"
        ],
        "estimatedDuration": 6,
