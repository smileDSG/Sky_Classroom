  "scenes": [
    {
      "id": "scene_6MKjs6xd8D",
      "stageId": "foOwpze5C_",
      "type": "interactive",
      "title": "探索单位圆",
      "order": 5,
      "content": {
        "type": "interactive",
        "url": "",
        "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n  <title>单位圆与三角函数 - 互动模拟</title>\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      background: linear-gradient(145deg, #f5f7fa 0%, #e6ecf5 100%);\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 12px;\n      touch-action: manipulation;\n    }\n    .widget-container {\n      background: rgba(255, 255, 255, 0.7);\n      backdrop-filter: blur(12px);\n      -webkit-backdrop-filter: blur(12px);\n      border-radius: 40px 40px 28px 28px;\n      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15), 0 4px 12px rgba(0, 0, 0, 0.06);\n      max-width: 780px;\n      width: 100%;\n      padding: 24px 20px 28px;\n      margin: 0 auto;\n      border: 1px solid rgba(255, 255, 255, 0.5);\n      transition: all 0.2s;\n    }\n    h2 {\n      margin: 0 0 6px 0;\n      font-weight: 600;\n      font-size: 1.6rem;\n      letter-spacing: -0.3px;\n      color: #1e293b;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      flex-wrap: wrap;\n    }\n    .subhead {\n      color: #4b5563;\n      margin-top: -4px;\n      margin-bottom: 16px;\n      font-size: 0.95rem;\n      opacity: 0.8;\n    }\n    .canvas-wrapper {\n      position: relative;\n      width: 100%;\n      background: rgba(255, 255, 255, 0.3);\n      border-radius: 28px;\n      overflow: hidden;\n      box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.04);\n      touch-action: none;\n    }\n    canvas {\n      display: block;\n      width: 100%;\n      height: auto;\n      aspect-ratio: 1 / 1;\n      max-height: 480px;\n      background: #ffffff;\n      border-radius: 28px;\n      touch-action: none;\n      cursor: pointer;\n    }\n    .controls-panel {\n      margin-top: 20px;\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n    }\n    .slider-group {\n      background: rgba(255, 255, 255, 0.6);\n      padding: 8px 12px 12px;\n      border-radius: 20px;\n      backdrop-filter: blur(4px);\n      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);\n    }\n    .slider-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: baseline;\n      font-weight: 500;\n      color: #1e293b;\n      margin-bottom: 4px;\n      font-size: 0.95rem;\n    }\n    .slider-header span:first-child {\n      display: flex;\n      align-items: center;\n      gap: 4px;\n    }\n    .slider-value {\n      font-family: 'SF Mono', 'Menlo', monospace;\n      font-weight: 600;\n      background: #eef2f6;\n      padding: 2px 12px;\n      border-radius: 30px;\n      color: #0f172a;\n      font-size: 0.9rem;\n    }\n    input[type=\"range\"] {\n      -webkit-appearance: none;\n      appearance: none;\n      width: 100%;\n      height: 8px;\n      background: linear-gradient(90deg, #b9c4d0, #6366f1);\n      border-radius: 20px;\n      outline: none;\n      transition: background 0.2s;\n      touch-action: manipulation;\n    }\n    input[type=\"range\"]::-webkit-slider-thumb {\n      -webkit-appearance: none;\n      appearance: none;\n      width: 28px;\n      height: 28px;\n      background: white;\n      border-radius: 30px;\n      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);\n      border: 2px solid #6366f1;\n      cursor: pointer;\n      transition: 0.15s;\n      touch-action: manipulation;\n    }\n    input[type=\"range\"]::-moz-range-thumb {\n      width: 28px;\n      height: 28px;\n      background: white;\n      border-radius: 30px;\n      border: 2px solid #6366f1;\n      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);\n      cursor: pointer;\n    }\n    .action-row {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n      margin-top: 6px;\n      justify-content: center;\n    }\n    button {\n      background: white;\n      border: none;\n      padding: 10px 20px;\n      border-radius: 40px;\n      font-weight: 600;\n      font-size: 1rem;\n      color: #1e293b;\n      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);\n      transition: 0.2s;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 6px;\n      cursor: pointer;\n      min-height: 48px;\n      min-width: 48px;\n      touch-action: manipulation;\n      border: 1px solid rgba(255, 255, 255, 0.7);\n      flex: 1 0 auto;\n    }\n    button:active {\n      transform: scale(0.95);\n    }\n    .btn-primary {\n      background: #6366f1;\n      color: white;\n      box-shadow: 0 6px 14px rgba(99, 102, 241, 0.35);\n      border: none;\n    }\n    .btn-primary:active {\n      background: #4f46e5;\n    }\n    .btn-secondary {\n      background: #f1f5f9;\n    }\n    .btn-success {\n      background: #10b981;\n      color: white;\n      border: none;\n    }\n    .btn-warning {\n      background: #f59e0b;\n      color: white;\n      border: none;\n    }\n    .preset-row {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      justify-content: center;\n      margin: 6px 0 0;\n    }\n    .preset-btn {\n      background: #eef2f6;\n      padding: 6px 14px;\n      font-size: 0.85rem;\n      border-radius: 40px;\n      border: 1px solid #dce2eb;\n      box-shadow: none;\n      min-height: 40px;\n      flex: 0 1 auto;\n    }\n    .preset-btn:active {\n      background: #dce2eb;\n    }\n    .state-indicator {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      background: rgba(0,0,0,0.04);\n      padding: 4px 14px 4px 10px;\n      border-radius: 40px;\n      font-size: 0.85rem;\n      color: #2c3e50;\n    }\n    .state-dot {\n      width: 10px;\n      height: 10px;\n      border-radius: 10px;\n      display: inline-block;\n    }\n    .dot-idle { background: #94a3b8; }\n    .dot-running { background: #10b981; animation: pulse-dot 1s infinite; }\n    .dot-paused { background: #f59e0b; }\n    .dot-ended { background: #ef4444; }\n    @keyframes pulse-dot {\n      0%, 100% { opacity: 1; transform: scale(1); }\n      50% { opacity: 0.5; transform: scale(0.9); }\n    }\n    .flex-between {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      justify-content: space-between;\n      gap: 8px;\n    }\n    /* mobile responsiveness */\n    @media (max-width: 520px) {\n      .widget-container {\n        padding: 16px 12px 20px;\n        border-radius: 28px;\n      }\n      h2 { font-size: 1.3rem; }\n      .action-row button {\n        font-size: 0.9rem;\n        padding: 8px 12px;\n        min-height: 44px;\n      }\n      .preset-btn {\n        font-size: 0.75rem;\n        padding: 4px 10px;\n        min-height: 36px;\n      }\n      canvas {\n        max-height: 340px;\n      }\n    }\n    @media (max-width: 400px) {\n      .slider-header {\n        font-size: 0.85rem;\n      }\n      .slider-value {\n        font-size: 0.8rem;\n      }\n      input[type=\"range\"]::-webkit-slider-thumb {\n        width: 26px;\n        height: 26px;\n      }\n    }\n    .annotation-tip {\n      background: rgba(99,102,241,0.12);\n      border-radius: 40px;\n      padding: 2px 16px;\n      color: #4338ca;\n      font-size: 0.8rem;\n    }\n    .sr-only {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      overflow: hidden;\n      clip: rect(0,0,0,0);\n      white-space: nowrap;\n      border: 0;\n    }\n  </style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css\">\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js\"></script>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    const katexOptions = {\n        delimiters: [\n            {left: '\\\\[', right: '\\\\]', display: true},\n            {left: '\\\\(', right: '\\\\)', display: false},\n            {left: '$$', right: '$$', display: true},\n            {left: '$', right: '$', display: false}\n        ],\n        throwOnError: false,\n        strict: false,\n        trust: true\n    };\n\n    let renderTimeout;\n    function safeRender() {\n        if (renderTimeout) clearTimeout(renderTimeout);\n        renderTimeout = setTimeout(() => {\n            renderMathInElement(document.body, katexOptions);\n        }, 100);\n    }\n\n    renderMathInElement(document.body, katexOptions);\n\n    const observer = new MutationObserver((mutations) => {\n        let shouldRender = false;\n        mutations.forEach((mutation) => {\n            if (mutation.target &&\n                mutation.target.className &&\n                typeof mutation.target.className === 'string' &&\n                mutation.target.className.includes('katex')) {\n                return;\n            }\n            shouldRender = true;\n        });\n\n        if (shouldRender) {\n            safeRender();\n        }\n    });\n\n    observer.observe(document.body, {\n        childList: true,\n        subtree: true,\n        characterData: true\n    });\n\n    setInterval(() => {\n        const text = document.body.innerText;\n        if (text.includes('\\\\(') || text.includes('$$')) {\n            safeRender();\n        }\n    }, 2000);\n});\n</script>\n</head>\n<body>\n  <div class=\"widget-container\" role=\"main\" aria-label=\"单位圆与三角函数互动模拟\">\n    <div class=\"flex-between\">\n      <div>\n        <h2>📐 单位圆与三角函数</h2>\n        <div class=\"subhead\">拖动角度滑块 · 观察 sin、cos、tan 的几何变化</div>\n      </div>\n      <div class=\"state-indicator\" id=\"state-indicator\">\n        <span class=\"state-dot dot-idle\" id=\"state-dot\"></span>\n        <span id=\"state-label\">就绪</span>\n      </div>\n    </div>\n\n    <!-- Canvas -->\n    <div class=\"canvas-wrapper\">\n      <canvas id=\"unitCircleCanvas\" width=\"600\" height=\"600\" aria-label=\"单位圆与三角函数可视化画布\"></canvas>\n    </div>\n\n    <!-- Controls -->\n    <div class=\"controls-panel\">\n      <!-- 角度滑条 -->\n      <div class=\"slider-group\">\n        <div class=\"slider-header\">\n          <span>🎯 角度 θ</span>\n          <span class=\"slider-value\" id=\"angle-display\">45°</span>\n        </div>\n        <input type=\"range\" id=\"angle-slider\" min=\"0\" max=\"360\" value=\"45\" step=\"0.5\" \n               aria-label=\"角度 θ，从0到360度\" data-var=\"angle\">\n      </div>\n\n      <!-- 实时数值 -->\n      <div style=\"display: flex; gap: 12px; flex-wrap: wrap; justify-content: space-between; background: rgba(255,255,255,0.5); border-radius: 20px; padding: 8px 16px;\">\n        <span><span style=\"color:#ef4444;\">sin(θ)</span> = <strong id=\"sin-display\" style=\"font-family: monospace;\">0.707</strong></span>\n        <span><span style=\"color:#3b82f6;\">cos(θ)</span> = <strong id=\"cos-display\" style=\"font-family: monospace;\">0.707</strong></span>\n        <span><span style=\"color:#10b981;\">tan(θ)</span> = <strong id=\"tan-display\" style=\"font-family: monospace;\">1.000</strong></span>\n      </div>\n\n      <!-- 按钮行 -->\n      <div class=\"action-row\" role=\"group\" aria-label=\"模拟控制\">\n        <button id=\"start-btn\" class=\"btn-primary\" aria-label=\"开始动画\">▶ 开始</button>\n        <button id=\"pause-btn\" class=\"btn-secondary\" aria-label=\"暂停动画\">⏸ 暂停</button>\n        <button id=\"reset-btn\" class=\"btn-warning\" aria-label=\"重置模拟\">↺ 重置</button>\n      </div>\n\n      <!-- 预设 -->\n      <div style=\"margin-top: 2px;\">\n        <div style=\"font-size: 0.8rem; color: #475569; margin-bottom: 4px;\">✨ 预设场景</div>\n        <div class=\"preset-row\" id=\"preset-row\">\n          <button class=\"preset-btn\" data-preset='{\"angle\":0}'>0° (x轴)</button>\n          <button class=\"preset-btn\" data-preset='{\"angle\":30}'>30°</button>\n          <button class=\"preset-btn\" data-preset='{\"angle\":45}'>45° (对称)</button>\n          <button class=\"preset-btn\" data-preset='{\"angle\":60}'>60°</button>\n          <button class=\"preset-btn\" data-preset='{\"angle\":90}'>90° (y轴)</button>\n          <button class=\"preset-btn\" data-preset='{\"angle\":180}'>180°</button>\n        </div>\n      </div>\n      <div style=\"font-size: 0.75rem; color: #64748b; margin-top: 4px; text-align: center;\">\n        <span class=\"annotation-tip\">💡 拖动角度观察点P在圆上运动</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Widget Config -->\n  <script type=\"application/json\" id=\"widget-config\">\n  {\n    \"type\": \"simulation\",\n    \"concept\": \"unit_circle_trig\",\n    \"description\": \"通过交互式单位圆可视化，直观理解三个三角函数在圆上的几何表示。\",\n    \"variables\": [\n      { \"name\": \"angle\", \"label\": \"角度 θ\", \"min\": 0, \"max\": 360, \"default\": 45, \"unit\": \"°\" }\n    ],\n    \"presets\": [\n      { \"name\": \"0° (x轴)\", \"variables\": { \"angle\": 0 } },\n      { \"name\": \"30°\", \"variables\": { \"angle\": 30 } },\n      { \"name\": \"45° (对称)\", \"variables\": { \"angle\": 45 } },\n      { \"name\": \"60°\", \"variables\": { \"angle\": 60 } },\n      { \"name\": \"90° (y轴)\", \"variables\": { \"angle\": 90 } },\n      { \"name\": \"180°\", \"variables\": { \"angle\": 180 } }\n    ]\n  }\n  </script>\n\n  <script>\n    (function() {\n      // ----- DOM refs -----\n      const canvas = document.getElementById('unitCircleCanvas');\n      const ctx = canvas.getContext('2d');\n      const angleSlider = document.getElementById('angle-slider');\n      const angleDisplay = document.getElementById('angle-display');\n      const sinDisplay = document.getElementById('sin-display');\n      const cosDisplay = document.getElementById('cos-display');\n      const tanDisplay = document.getElementById('tan-display');\n      const startBtn = document.getElementById('start-btn');\n      const pauseBtn = document.getElementById('pause-btn');\n      const resetBtn = document.getElementById('reset-btn');\n      const stateDot = document.getElementById('state-dot');\n      const stateLabel = document.getElementById('state-label');\n\n      // ----- state -----\n      let angleDeg = 45;           // current angle in degrees\n      let animAngle = 45;          // animated angle (for smooth rotation)\n      let running = false;\n      let paused = false;\n      let ended = false;\n      let animId = null;\n      let autoRotateSpeed = 0.3;   // degrees per frame when running\n\n      // ----- helpers -----\n      function degToRad(deg) { return deg * Math.PI / 180; }\n\n      // ----- update displays & slider -----\n      function updateUIFromAngle(deg) {\n        // round\n        const rounded = Math.round(deg * 10) / 10;\n        angleDisplay.textContent = rounded + '°';\n        // don't update slider to avoid feedback loop if called from slider\n        const rad = degToRad(deg);\n        const sinVal = Math.sin(rad);\n        const cosVal = Math.cos(rad);\n        const tanVal = (Math.abs(cosVal) < 1e-10) ? Infinity : sinVal / cosVal;\n\n        sinDisplay.textContent = sinVal.toFixed(4);\n        cosDisplay.textContent = cosVal.toFixed(4);\n        if (Math.abs(tanVal) > 9999 || !isFinite(tanVal)) {\n          tanDisplay.textContent = '∞';\n        } else {\n          tanDisplay.textContent = tanVal.toFixed(4);\n        }\n      }\n\n      function setState(mode) {\n        // mode: 'idle', 'running', 'paused', 'ended'\n        const dot = stateDot;\n        dot.className = 'state-dot';\n        if (mode === 'idle') {\n          dot.classList.add('dot-idle');\n          stateLabel.textContent = '就绪';\n        } else if (mode === 'running') {\n          dot.classList.add('dot-running');\n          stateLabel.textContent = '运行中';\n        } else if (mode === 'paused') {\n          dot.classList.add('dot-paused');\n          stateLabel.textContent = '已暂停';\n        } else if (mode === 'ended') {\n          dot.classList.add('dot-ended');\n          stateLabel.textContent = '结束';\n        }\n        // update buttons\n        if (mode === 'running') {\n          startBtn.textContent = '▶ 运行';\n          startBtn.disabled = true;\n          pauseBtn.textContent = '⏸ 暂停';\n          pauseBtn.disabled = false;\n        } else if (mode === 'paused') {\n          startBtn.textContent = '▶ 继续';\n          startBtn.disabled = false;\n          pauseBtn.textContent = '⏸ 暂停';\n          pauseBtn.disabled = true;\n        } else if (mode === 'ended' || mode === 'idle') {\n          startBtn.textContent = '▶ 开始';\n          startBtn.disabled = false;\n          pauseBtn.textContent = '⏸ 暂停';\n          pauseBtn.disabled = true;\n        }\n      }\n\n      // ----- draw canvas -----\n      function drawScene(deg) {\n        const dpr = window.devicePixelRatio || 1;\n        const rect = canvas.getBoundingClientRect();\n        const w = rect.width;\n        const h = rect.height;\n        if (w === 0 || h === 0) return;\n\n        // Set canvas buffer size\n        canvas.width = w * dpr;\n        canvas.height = h * dpr;\n        ctx.scale(dpr, dpr);\n\n        const size = Math.min(w, h);\n        const cx = w / 2;\n        const cy = h / 2;\n        const radius = size * 0.38;\n\n        // clear\n        ctx.clearRect(0, 0, w, h);\n\n        // background\n        ctx.fillStyle = '#fafcff';\n        ctx.fillRect(0, 0, w, h);\n\n        // ---- grid lines (light) ----\n        ctx.strokeStyle = '#e2e8f0';\n        ctx.lineWidth = 1;\n        for (let i = -1; i <= 1; i+=2) {\n          ctx.beginPath();\n          ctx.moveTo(cx + i * radius, cy - radius * 0.1);\n          ctx.lineTo(cx + i * radius, cy + radius * 0.1);\n          ctx.stroke();\n          ctx.beginPath();\n          ctx.moveTo(cx - radius * 0.1, cy + i * radius);\n          ctx.lineTo(cx + radius * 0.1, cy + i * radius);\n          ctx.stroke();\n        }\n\n        // axes\n        ctx.strokeStyle = '#1e293b';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.moveTo(cx - radius * 1.3, cy);\n        ctx.lineTo(cx + radius * 1.3, cy);\n        ctx.stroke();\n        ctx.beginPath();\n        ctx.moveTo(cx, cy - radius * 1.3);\n        ctx.lineTo(cx, cy + radius * 1.3);\n        ctx.stroke();\n\n        // unit circle\n        ctx.beginPath();\n        ctx.arc(cx, cy, radius, 0, 2 * Math.PI);\n        ctx.strokeStyle = '#475569';\n        ctx.lineWidth = 2.5;\n        ctx.stroke();\n\n        // inner fill hint\n        ctx.fillStyle = 'rgba(99, 102, 241, 0.04)';\n        ctx.beginPath();\n        ctx.arc(cx, cy, radius, 0, 2 * Math.PI);\n        ctx.fill();\n\n        // ---- angle arc ----\n        const rad = degToRad(deg);\n        // arc from positive x-axis\n        ctx.beginPath();\n        ctx.moveTo(cx, cy);\n        ctx.arc(cx, cy, radius * 0.3, 0, -rad, true); // clockwise in canvas\n        ctx.closePath();\n        ctx.fillStyle = 'rgba(99, 102, 241, 0.15)';\n        ctx.fill();\n        ctx.strokeStyle = '#6366f1';\n        ctx.lineWidth = 2;\n        ctx.stroke();\n\n        // angle label\n        const labelR = radius * 0.42;\n        const midAngle = -rad / 2;\n        ctx.fillStyle = '#4338ca';\n        ctx.font = '14px system-ui, sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText('θ', cx + labelR * Math.cos(midAngle), cy + labelR * Math.sin(midAngle));\n\n        // ---- point P on circle ----\n        const px = cx + radius * Math.cos(rad);\n        const py = cy - radius * Math.sin(rad);  // y inverted for screen\n\n        // draw triangle lines (sin, cos)\n        // cos line (horizontal, blue)\n        ctx.beginPath();\n        ctx.moveTo(cx, cy);\n        ctx.lineTo(px, cy);\n        ctx.strokeStyle = '#3b82f6';\n        ctx.lineWidth = 3;\n        ctx.stroke();\n\n        // sin line (vertical, red)\n        ctx.beginPath();\n        ctx.moveTo(px, cy);\n        ctx.lineTo(px, py);\n        ctx.strokeStyle = '#ef4444';\n        ctx.lineWidth = 3;\n        ctx.stroke();\n\n        // tan line (if not near 90/270)\n        const cosVal = Math.cos(rad);\n        const sinVal = Math.sin(rad);\n        if (Math.abs(cosVal) > 0.02) {\n          const tanVal = sinVal / cosVal;\n          // tangent segment from (1,0) to (1, tan) on unit circle representation\n          const tx = cx + radius;\n          const ty = cy - radius * tanVal;\n          // clip to visible\n          ctx.beginPath();\n          ctx.moveTo(cx + radius, cy);\n          ctx.lineTo(tx, ty);\n          ctx.strokeStyle = '#10b981';\n          ctx.lineWidth = 2.5;\n          ctx.setLineDash([6, 5]);\n          ctx.stroke();\n          ctx.setLineDash([]);\n          // small label\n          if (Math.abs(tanVal) < 4) {\n            ctx.fillStyle = '#059669';\n            ctx.font = '13px system-ui, sans-serif';\n            ctx.textAlign = 'left';\n            ctx.textBaseline = 'bottom';\n            ctx.fillText('tan', tx + 6, ty - 4);\n          }\n        }\n\n        // draw point P (big)\n        ctx.beginPath();\n        ctx.arc(px, py, 8, 0, 2 * Math.PI);\n        ctx.fillStyle = '#1e293b';\n        ctx.fill();\n        ctx.strokeStyle = 'white';\n        ctx.lineWidth = 2;\n        ctx.stroke();\n\n        // point label P\n        ctx.fillStyle = '#0f172a';\n        ctx.font = 'bold 16px system-ui, sans-serif';\n        ctx.textAlign = 'left';\n        ctx.textBaseline = 'bottom';\n        ctx.fillText('P', px + 12, py - 4);\n\n        // axis labels\n        ctx.fillStyle = '#334155';\n        ctx.font = '13px system-ui, sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'top';\n        ctx.fillText('x', cx + radius * 1.25, cy + 6);\n        ctx.textBaseline = 'right';\n        ctx.fillText('y', cx + 6, cy - radius * 1.25 - 4);\n        ctx.textAlign = 'left';\n        ctx.textBaseline = 'middle';\n        ctx.fillText('1', cx + radius + 6, cy);\n        ctx.fillText('−1', cx - radius - 28, cy);\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'bottom';\n        ctx.fillText('1', cx, cy - radius - 6);\n        ctx.fillText('−1', cx, cy + radius + 18);\n\n        // cos/sin value indicators near axes\n        ctx.fillStyle = '#2563eb';\n        ctx.font = '12px system-ui, sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'top';\n        const cosDisplayX = cx + radius * 0.5;\n        ctx.fillText('cos', cosDisplayX, cy + 10);\n        ctx.fillStyle = '#dc2626';\n        const sinDisplayY = cy - radius * 0.5;\n        ctx.textAlign = 'left';\n        ctx.textBaseline = 'middle';\n        ctx.fillText('sin', px + 8, cy - radius * 0.5);\n\n        // real-time values on canvas\n        ctx.fillStyle = 'rgba(0,0,0,0.6)';\n        ctx.font = '13px monospace';\n        ctx.textAlign = 'left';\n        ctx.textBaseline = 'top';\n        ctx.fillText('sin = ' + sinVal.toFixed(3), 12, 14);\n        ctx.fillStyle = 'rgba(0,0,0,0.6)';\n        ctx.fillText('cos = ' + Math.cos(rad).toFixed(3), 12, 32);\n        ctx.fillStyle = 'rgba(0,0,0,0.6)';\n        const tanShow = (Math.abs(cosVal) < 0.001) ? '∞' : (sinVal/cosVal).toFixed(3);\n        ctx.fillText('tan = ' + tanShow, 12, 50);\n      }\n\n      // ----- animation loop -----\n      function animate() {\n        if (!running || paused) {\n          animId = null;\n          return;\n        }\n        // update angle\n        animAngle = (animAngle + autoRotateSpeed) % 360;\n        angleDeg = animAngle;\n        // sync slider (without triggering event)\n        if (angleSlider.value != angleDeg.toFixed(1)) {\n          angleSlider.value = angleDeg.toFixed(1);\n        }\n        updateUIFromAngle(angleDeg);\n        drawScene(angleDeg);\n\n        animId = requestAnimationFrame(animate);\n      }\n\n      // ----- start / pause / reset -----\n      function startSim() {\n        if (ended) {\n          // reset ended state\n          ended = false;\n          animAngle = angleDeg;\n        }\n        if (paused) {\n          paused = false;\n          running = true;\n          setState('running');\n          if (!animId) {\n            animId = requestAnimationFrame(animate);\n          }\n          return;\n        }\n        if (running) return;\n        running = true;\n        paused = false;\n        ended = false;\n        animAngle = angleDeg;\n        setState('running');\n        if (!animId) {\n          animId = requestAnimationFrame(animate);\n        }\n      }\n\n      function pauseSim() {\n        if (!running) return;\n        paused = true;\n        setState('paused');\n        if (animId) {\n          cancelAnimationFrame(animId);\n          animId = null;\n        }\n      }\n\n      function resetSim() {\n        // stop any animation\n        if (animId) {\n          cancelAnimationFrame(animId);\n          animId = null;\n        }\n        running = false;\n        paused = false;\n        ended = false;\n        // reset angle to default (45)\n        const defaultAngle = 45;\n        angleDeg = defaultAngle;\n        animAngle = defaultAngle;\n        angleSlider.value = defaultAngle;\n        updateUIFromAngle(defaultAngle);\n        drawScene(defaultAngle);\n        setState('idle');\n      }\n\n      // ----- slider input -----\n      angleSlider.addEventListener('input', function(e) {\n        const val = parseFloat(e.target.value);\n        angleDeg = val;\n        animAngle = val; // sync animated angle\n        // if running, keep going from new angle\n        updateUIFromAngle(val);\n        drawScene(val);\n        // if running and not paused, continue\n        if (running && !paused) {\n          if (animId) {\n            cancelAnimationFrame(animId);\n            animId = null;\n          }\n          animId = requestAnimationFrame(animate);\n        }\n      });\n\n      // ----- buttons -----\n      startBtn.addEventListener('click', startSim);\n      pauseBtn.addEventListener('click', pauseSim);\n      resetBtn.addEventListener('click', resetSim);\n\n      // ----- presets -----\n      document.querySelectorAll('[data-preset]').forEach(btn => {\n        btn.addEventListener('click', function() {\n          const preset = JSON.parse(this.dataset.preset);\n          const newAngle = preset.angle;\n          // stop any animation\n          if (animId) {\n            cancelAnimationFrame(animId);\n            animId = null;\n          }\n          running = false; paused = false; ended = false;\n          angleDeg = newAngle;\n          animAngle = newAngle;\n          angleSlider.value = newAngle;\n          updateUIFromAngle(newAngle);\n          drawScene(newAngle);\n          setState('idle');\n        });\n      });\n\n      // ----- keyboard shortcuts -----\n      document.addEventListener('keydown', function(e) {\n        if (e.key === ' ' || e.key === 'Space') {\n          e.preventDefault();\n          if (running && !paused) pauseSim();\n          else startSim();\n        }\n        if (e.key === 'r' || e.key === 'R') {\n          e.preventDefault();\n          resetSim();\n        }\n      });\n\n      // ----- resize handling -----\n      function resizeCanvas() {\n        drawScene(angleDeg);\n      }\n      const resizeObserver = new ResizeObserver(() => { resizeCanvas(); });\n      resizeObserver.observe(canvas);\n      window.addEventListener('resize', resizeCanvas);\n\n      // ----- postMessage listener (teacher actions) -----\n      window.addEventListener('message', function(event) {\n        const { type, target, state, content } = event.data || {};\n        switch (type) {\n          case 'SET_WIDGET_STATE': {\n            if (state && typeof state.angle !== 'undefined') {\n              const newAngle = Math.min(360, Math.max(0, parseFloat(state.angle)));\n              // stop animation\n              if (animId) { cancelAnimationFrame(animId); animId = null; }\n              running = false; paused = false; ended = false;\n              angleDeg = newAngle;\n              animAngle = newAngle;\n              angleSlider.value = newAngle;\n              updateUIFromAngle(newAngle);\n              drawScene(newAngle);\n              setState('idle');\n            }\n            break;\n          }\n          case 'HIGHLIGHT_ELEMENT': {\n            const highlightEl = document.querySelector(target);\n            if (highlightEl) {\n              highlightEl.style.outline = '3px solid rgba(139, 92, 246, 0.8)';\n              highlightEl.style.outlineOffset = '4px';\n              highlightEl.style.animation = 'pulse-highlight 2s infinite';\n              setTimeout(() => {\n                highlightEl.style.outline = '';\n                highlightEl.style.animation = '';\n              }, 3000);\n            }\n            break;\n          }\n          case 'ANNOTATE_ELEMENT': {\n            const annotateEl = document.querySelector(target);\n            if (annotateEl && content) {\n              const rect = annotateEl.getBoundingClientRect();\n              const tooltip = document.createElement('div');\n              tooltip.className = 'teacher-annotation';\n              tooltip.style.cssText = 'position:fixed; top:' + (rect.top - 40) + 'px; left:' + rect.left + 'px; background:rgba(139,92,246,0.95); color:white; padding:8px 12px; border-radius:8px; font-size:14px; z-index:1000; animation:fadeIn 0.3s;';\n              tooltip.textContent = content;\n              document.body.appendChild(tooltip);\n              setTimeout(() => tooltip.remove(), 4000);\n            }\n            break;\n          }\n          case 'REVEAL_ELEMENT': {\n            const revealEl = document.querySelector(target);\n            if (revealEl) {\n              revealEl.style.display = '';\n              revealEl.style.opacity = '1';\n            }\n            break;\n          }\n        }\n      });\n\n      // Inject keyframe styles if not already present\n      if (!document.querySelector('#pulse-highlight-style')) {\n        const style = document.createElement('style');\n        style.id = 'pulse-highlight-style';\n        style.textContent = `\n          @keyframes pulse-highlight { 0%, 100% { outline-color: rgba(139, 92, 246, 0.8); } 50% { outline-color: rgba(139, 92, 246, 0.4); } }\n          @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n        `;\n        document.head.appendChild(style);\n      }\n\n      // ----- init -----\n      resetSim();\n    })();\n  </script>\n</body>\n</html>",
