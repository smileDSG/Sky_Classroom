              "top": 60,
              "width": 880,
              "height": 70,
              "content": "<p style=\"font-size: 32px;\"><strong>编写你的第一个Python程序</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1a1a1a",
              "rotate": 0
            },
            {
              "id": "shape_8coKLAfc",
              "type": "shape",
              "left": 60,
