      "content": {
        "type": "interactive",
        "url": "",
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.5, user-scalable=yes\">\n    <title>🧪 Experiment with Variables – Python Playground</title>\n\n    <!-- CodeMirror CDN (syntax highlighting + editor) -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.css\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/theme/dracula.min.css\">\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/python/python.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/addon/active-line.js\"></script>\n\n    <!-- Pyodide (Python in browser) -->\n    <script src=\"https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js\"></script>\n\n    <style>\n        * { box-sizing: border-box; margin: 0; padding: 0; }\n        body {\n            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n            background: #1e1e2e;\n            min-height: 100vh;\n            display: flex;\n            justify-content: center;\n            align-items: flex-start;\n            padding: 1.5rem 1rem 3rem;\n            color: #e0e0e0;\n        }\n        .widget {\n            max-width: 1100px;\n            width: 100%;\n            background: #2a2a3e;\n            border-radius: 36px;\n            box-shadow: 0 20px 40px rgba(0,0,0,0.6);\n            padding: 1.6rem 1.5rem 2rem;\n            transition: all 0.2s;\n        }\n\n        h2 {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n            font-weight: 500;\n            font-size: 1.8rem;\n            letter-spacing: -0.3px;\n            color: #c8f0ff;\n            margin-bottom: 0.6rem;\n            flex-wrap: wrap;\n        }\n        .sub {\n            color: #a0b8cc;\n            margin-bottom: 1.4rem;\n            font-size: 0.95rem;\n            border-left: 4px solid #6c63ff;\n            padding-left: 14px;\n            background: #1e1e30;\n            border-radius: 0 20px 20px 0;\n            line-height: 1.5;\n        }\n        .editor-panel {\n            display: flex;\n            flex-direction: column;\n            gap: 12px;\n        }\n        .code-area {\n            position: relative;\n            border-radius: 22px;\n            overflow: hidden;\n            border: 1px solid #444470;\n            background: #1e1e2e;\n        }\n        .CodeMirror {\n            height: 260px;\n            font-size: 1rem;\n            font-weight: 500;\n            background: #1a1a2a;\n            border-radius: 22px;\n            padding: 6px 0;\n        }\n        .CodeMirror-gutters {\n            background: #21213a;\n            border-right: 1px solid #39395a;\n        }\n\n        .action-bar {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 12px;\n            align-items: center;\n            justify-content: space-between;\n            margin: 10px 0 6px;\n        }\n        .btn-group {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 10px;\n        }\n        .btn {\n            background: #3b3b5a;\n            border: none;\n            color: #f0f0f8;\n            padding: 10px 22px;\n            border-radius: 60px;\n            font-weight: 600;\n            font-size: 0.9rem;\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n            cursor: pointer;\n            transition: all 0.15s;\n            box-shadow: 0 4px 8px rgba(0,0,0,0.4);\n            border: 1px solid #52527a;\n        }\n        .btn-primary {\n            background: #6c63ff;\n            border-color: #8b83ff;\n        }\n        .btn-primary:active { transform: scale(0.96); }\n        .btn:disabled {\n            opacity: 0.5;\n            pointer-events: none;\n            filter: grayscale(0.3);\n        }\n        .btn:hover:not(:disabled) {\n            background: #5f57e0;\n            border-color: #aaa5ff;\n        }\n        .btn-clear {\n            background: #3b3b60;\n        }\n\n        .status-badge {\n            background: #38385a;\n            padding: 6px 20px;\n            border-radius: 40px;\n            font-size: 0.8rem;\n            font-weight: 500;\n            color: #b0c8ff;\n            border: 1px solid #55558a;\n        }\n\n        .split-panels {\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n            margin-top: 22px;\n        }\n\n        .output-panel {\n            background: #151525;\n            border-radius: 26px;\n            padding: 1rem 1.2rem;\n            border: 1px solid #3d3d68;\n            min-height: 120px;\n            max-height: 240px;\n            overflow-y: auto;\n            font-family: 'JetBrains Mono', 'Fira Code', monospace;\n            font-size: 0.9rem;\n            white-space: pre-wrap;\n            word-break: break-word;\n        }\n        .output-empty {\n            color: #6a6a8a;\n            font-style: italic;\n        }\n\n        .test-hint-row {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 18px;\n            justify-content: space-between;\n        }\n        .test-cases {\n            flex: 2 1 280px;\n            background: #1e1e32;\n            border-radius: 28px;\n            padding: 1rem 1rem 0.8rem;\n            border: 1px solid #3f3f68;\n        }\n        .test-cases summary {\n            font-weight: 600;\n            cursor: pointer;\n            color: #b0caff;\n            font-size: 0.95rem;\n            padding: 4px 0 8px;\n            list-style: '▶ ';\n        }\n        .test-cases[open] summary { list-style: '▼ '; }\n        .test-item {\n            display: flex;\n            align-items: baseline;\n            justify-content: space-between;\n            padding: 6px 0;\n            border-bottom: 1px solid #2c2c4e;\n            font-size: 0.9rem;\n            gap: 8px;\n            flex-wrap: wrap;\n        }\n        .test-result {\n            font-weight: 600;\n            padding: 0 8px;\n        }\n        .pass { color: #8bff90; }\n        .fail { color: #ff7a7a; }\n        .pending { color: #a8a8c0; }\n\n        .hints-area {\n            flex: 1 1 180px;\n            background: #1a1a30;\n            border-radius: 28px;\n            padding: 0.9rem 1rem 0.9rem;\n            border: 1px solid #3d3d5a;\n        }\n        .hints-area h4 {\n            color: #b5ceff;\n            font-weight: 500;\n            display: flex;\n            gap: 10px;\n            align-items: center;\n            margin-bottom: 8px;\n        }\n        .hint-btn {\n            background: #4b4b7a;\n            border: 1px solid #6c6ca0;\n            padding: 4px 16px;\n            border-radius: 40px;\n            color: white;\n            font-weight: 500;\n            cursor: pointer;\n            transition: 0.1s;\n        }\n        .hint-btn:hover { background: #6b6baa; }\n        .hint-text {\n            color: #c6d9ff;\n            font-size: 0.9rem;\n            margin-top: 10px;\n            background: #232345;\n            padding: 10px 14px;\n            border-radius: 24px;\n            line-height: 1.5;\n        }\n\n        /* mobile optimize */\n        @media (max-width: 600px) {\n            .widget { padding: 1rem 0.8rem; }\n            .CodeMirror { height: 200px !important; }\n            .btn { padding: 8px 14px; font-size: 0.8rem; }\n            .action-bar { flex-direction: column; align-items: stretch; }\n            .btn-group { justify-content: stretch; }\n            .btn-group .btn { flex: 1; justify-content: center; }\n            .status-badge { text-align: center; }\n        }\n    </style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css\">\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js\"></script>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    const katexOptions = {\n        delimiters: [\n            {left: '\\\\[', right: '\\\\]', display: true},\n            {left: '\\\\(', right: '\\\\)', display: false},\n            {left: '$$', right: '$$', display: true},\n            {left: '$', right: '$', display: false}\n        ],\n        throwOnError: false,\n        strict: false,\n        trust: true\n    };\n\n    let renderTimeout;\n    function safeRender() {\n        if (renderTimeout) clearTimeout(renderTimeout);\n        renderTimeout = setTimeout(() => {\n            renderMathInElement(document.body, katexOptions);\n        }, 100);\n    }\n\n    renderMathInElement(document.body, katexOptions);\n\n    const observer = new MutationObserver((mutations) => {\n        let shouldRender = false;\n        mutations.forEach((mutation) => {\n            if (mutation.target &&\n                mutation.target.className &&\n                typeof mutation.target.className === 'string' &&\n                mutation.target.className.includes('katex')) {\n                return;\n            }\n            shouldRender = true;\n        });\n\n        if (shouldRender) {\n            safeRender();\n        }\n    });\n\n    observer.observe(document.body, {\n        childList: true,\n        subtree: true,\n        characterData: true\n    });\n\n    setInterval(() => {\n        const text = document.body.innerText;\n        if (text.includes('\\\\(') || text.includes('$$')) {\n            safeRender();\n        }\n    }, 2000);\n});\n</script>\n</head>\n<body>\n<div class=\"widget\">\n    <h2>🧪 Experiment with Variables</h2>\n    <div class=\"sub\">Python · create variables, add, concatenate, and see instant results.</div>\n\n    <!-- Widget config JSON (embedded) -->\n    <script type=\"application/json\" id=\"widget-config\">\n    {\n        \"type\": \"code\",\n        \"language\": \"python\",\n        \"description\": \"Interactive code environment for learners to create and manipulate variables.\",\n        \"starterCode\": \"# Create variables of different types\\nname = \\\"Alice\\\"\\nage = 15\\nscore = 92.5\\nprint(\\\"Hello, \\\" + name + \\\"!\\\")\\nprint(\\\"Age:\\\", age, \\\"Score:\\\", score)\\n# Try adding / concatenating below\\n\",\n        \"testCases\": [\n            { \"id\": \"t1\", \"input\": \"\", \"expected\": \"Alice\", \"description\": \"Variable 'name' must contain 'Alice'\" },\n            { \"id\": \"t2\", \"input\": \"\", \"expected\": \"15\", \"description\": \"Variable 'age' equals 15 (int)\" }\n        ],\n        \"hints\": [\n            \"Use `=` to assign a value to a variable.\",\n            \"Text strings need quotes: \\\"hello\\\"\",\n            \"You can add numbers: x = 10 + 5\",\n            \"Combine text with + : \\\"Hi \\\" + name\"\n        ],\n        \"solution\": \"name = \\\"Alice\\\"\\nage = 15\\nscore = 92.5\\nprint(\\\"Hello, \\\" + name + \\\"!\\\")\\nprint(\\\"Age:\\\", age, \\\"Score:\\\", score)\"\n    }\n    </script>\n\n    <!-- Editor area -->\n    <div class=\"editor-panel\">\n        <div class=\"code-area\">\n            <textarea id=\"code-editor\"># Create variables of different types\nname = \"Alice\"\nage = 15\nscore = 92.5\nprint(\"Hello, \" + name + \"!\")\nprint(\"Age:\", age, \"Score:\", score)\n# Try adding / concatenating below\n</textarea>\n        </div>\n\n        <div class=\"action-bar\">\n            <div class=\"btn-group\">\n                <button class=\"btn btn-primary\" id=\"runBtn\">▶ Run</button>\n                <button class=\"btn btn-clear\" id=\"clearBtn\">⌧ Clear output</button>\n                <button class=\"btn\" id=\"resetCodeBtn\">↺ Reset code</button>\n            </div>\n            <span class=\"status-badge\" id=\"statusBadge\">🧠 ready</span>\n        </div>\n    </div>\n\n    <!-- split panels: output + test/hints -->\n    <div class=\"split-panels\">\n        <div class=\"output-panel\" id=\"outputPanel\"><span class=\"output-empty\">⏎ output will appear here</span></div>\n\n        <div class=\"test-hint-row\">\n            <!-- Test cases -->\n            <div class=\"test-cases\" id=\"testCasesBox\">\n                <details open>\n                    <summary>✅ Test cases</summary>\n                    <div id=\"testList\">\n                        <div class=\"test-item\" data-testid=\"t1\">\n                            <span>🔹 t1: name contains \"Alice\"</span>\n                            <span class=\"test-result pending\">⚪ pending</span>\n                        </div>\n                        <div class=\"test-item\" data-testid=\"t2\">\n                            <span>🔹 t2: age == 15</span>\n                            <span class=\"test-result pending\">⚪ pending</span>\n                        </div>\n                    </div>\n                </details>\n            </div>\n\n            <!-- Hints -->\n            <div class=\"hints-area\">\n                <h4>💡 hints <button class=\"hint-btn\" id=\"hintBtn\">show</button></h4>\n                <div id=\"hintContainer\" style=\"min-height: 2.2rem;\">\n                    <span style=\"color:#6a6a8a; font-size:0.85rem;\">click to reveal</span>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n    (function(){\n        // ---------- Configuration ----------\n        const config = {\n            starterCode: `# Create variables of different types\nname = \"Alice\"\nage = 15\nscore = 92.5\nprint(\"Hello, \" + name + \"!\")\nprint(\"Age:\", age, \"Score:\", score)\n# Try adding / concatenating below\n`,\n            testCases: [\n                { id: 't1', description: 'name contains \"Alice\"', expected: 'Alice' },\n                { id: 't2', description: 'age == 15 (int)', expected: '15' }\n            ],\n            hints: [\n                \"Use `=` to assign a value to a variable.\",\n                \"Text strings need quotes: \\\"hello\\\"\",\n                \"You can add numbers: x = 10 + 5\",\n                \"Combine text with + : \\\"Hi \\\" + name\"\n            ]\n        };\n\n        // ---------- CodeMirror ----------\n        const textarea = document.getElementById('code-editor');\n        const editor = CodeMirror.fromTextArea(textarea, {\n            mode: 'python',\n            theme: 'dracula',\n            lineNumbers: true,\n            indentUnit: 4,\n            showCursorWhenSelecting: true,\n            styleActiveLine: true,\n            autoCloseBrackets: true,\n            matchBrackets: true,\n            viewportMargin: Infinity,\n            lineWrapping: false,\n            extraKeys: {\"Tab\": \"indentMore\"}\n        });\n        editor.setValue(config.starterCode);\n        editor.setSize(null, 260);\n\n        // ---------- DOM refs ----------\n        const runBtn = document.getElementById('runBtn');\n        const clearBtn = document.getElementById('clearBtn');\n        const resetCodeBtn = document.getElementById('resetCodeBtn');\n        const outputPanel = document.getElementById('outputPanel');\n        const statusBadge = document.getElementById('statusBadge');\n        const hintBtn = document.getElementById('hintBtn');\n        const hintContainer = document.getElementById('hintContainer');\n        const testListEl = document.getElementById('testList');\n\n        // ---------- Pyodide init (async) ----------\n        let pyodide = null;\n        let pyodideReady = false;\n\n        async function initPyodide() {\n            try {\n                statusBadge.textContent = '⏳ loading Pyodide...';\n                pyodide = await loadPyodide({\n                    indexURL: \"https://cdn.jsdelivr.net/pyodide/v0.25.0/full/\"\n                });\n                // capture stdout via proper async import\n                await pyodide.runPythonAsync(`\n                    import sys\n                    import io\n                    sys.stdout = io.StringIO()\n                `);\n                pyodideReady = true;\n                statusBadge.textContent = '✅ Python ready';\n                runBtn.disabled = false;\n            } catch (err) {\n                statusBadge.textContent = '⚠️ Pyodide error';\n                outputPanel.innerHTML = '❌ Failed to load Python engine: ' + err.message;\n                runBtn.disabled = true;\n            }\n        }\n\n        // ---------- Run user code (async) ----------\n        async function runCode() {\n            if (!pyodideReady || !pyodide) {\n                outputPanel.innerHTML = '⏳ Python not ready yet, please wait.';\n                return;\n            }\n\n            const code = editor.getValue();\n            outputPanel.innerHTML = '⏳ running...';\n            statusBadge.textContent = '⚡ executing';\n\n            try {\n                // Reset stdout capture (fresh StringIO)\n                await pyodide.runPythonAsync(`\n                    import sys\n                    import io\n                    sys.stdout = io.StringIO()\n                `);\n\n                // Execute user code\n                await pyodide.runPythonAsync(code);\n\n                // Retrieve stdout\n                const stdout = await pyodide.runPythonAsync(`\n                    sys.stdout.getvalue()\n                `);\n                const outputText = stdout ? stdout : '✔ (no output)';\n                outputPanel.textContent = outputText;\n\n                // ---------- Run test cases (dynamic) ----------\n                runTestCases(pyodide, outputText);\n\n                statusBadge.textContent = '✅ done';\n            } catch (err) {\n                outputPanel.textContent = '❌ ' + err.message;\n                statusBadge.textContent = '⚠️ error';\n                // Mark tests as pending\n                document.querySelectorAll('.test-result').forEach(el => {\n                    el.className = 'test-result pending';\n                    el.textContent = '⚪ pending';\n                });\n            }\n        }\n\n        // ---------- Test evaluation ----------\n        async function runTestCases(pyodide, outputText) {\n            // We'll test by checking variables in pyodide global scope\n            const testResults = [];\n            // t1: name == \"Alice\"\n            try {\n                const nameVal = await pyodide.runPythonAsync(`name`);\n                const pass1 = (String(nameVal) === 'Alice');\n                testResults.push({ id: 't1', pass: pass1 });\n            } catch (e) {\n                testResults.push({ id: 't1', pass: false });\n            }\n            // t2: age == 15\n            try {\n                const ageVal = await pyodide.runPythonAsync(`age`);\n                const pass2 = (Number(ageVal) === 15);\n                testResults.push({ id: 't2', pass: pass2 });\n            } catch (e) {\n                testResults.push({ id: 't2', pass: false });\n            }\n\n            // update DOM\n            testResults.forEach(res => {\n                const item = document.querySelector(`.test-item[data-testid=\"${res.id}\"]`);\n                if (!item) return;\n                const resultSpan = item.querySelector('.test-result');\n                if (res.pass) {\n                    resultSpan.className = 'test-result pass';\n                    resultSpan.textContent = '✅ pass';\n                } else {\n                    resultSpan.className = 'test-result fail';\n                    resultSpan.textContent = '❌ fail';\n                }\n            });\n            // if any test missing, keep pending\n        }\n\n        // ---------- Hints (progressive) ----------\n        let hintIndex = 0;\n        function showNextHint() {\n            if (!config.hints || config.hints.length === 0) {\n                hintContainer.innerHTML = '💡 no hints available.';\n                return;\n            }\n            if (hintIndex >= config.hints.length) {\n                hintContainer.innerHTML = '📌 No more hints!';\n                return;\n            }\n            const hint = config.hints[hintIndex];\n            hintIndex++;\n            // append new hint\n            const existing = hintContainer.querySelector('.hint-text');\n            if (existing) {\n                const newHint = document.createElement('div');\n                newHint.className = 'hint-text';\n                newHint.textContent = `✨ ${hint}`;\n                hintContainer.appendChild(newHint);\n            } else {\n                hintContainer.innerHTML = `<div class=\"hint-text\">✨ ${hint}</div>`;\n            }\n        }\n        // initial empty\n        hintBtn.addEventListener('click', showNextHint);\n\n        // ---------- UI controls ----------\n        runBtn.addEventListener('click', runCode);\n\n        clearBtn.addEventListener('click', function() {\n            outputPanel.innerHTML = '<span class=\"output-empty\">⏎ output cleared</span>';\n            // reset test results to pending\n            document.querySelectorAll('.test-result').forEach(el => {\n                el.className = 'test-result pending';\n                el.textContent = '⚪ pending';\n            });\n            statusBadge.textContent = '🧹 cleared';\n        });\n\n        resetCodeBtn.addEventListener('click', function() {\n            editor.setValue(config.starterCode);\n            outputPanel.innerHTML = '<span class=\"output-empty\">⏎ code reset</span>';\n            document.querySelectorAll('.test-result').forEach(el => {\n                el.className = 'test-result pending';\n                el.textContent = '⚪ pending';\n            });\n            hintIndex = 0;\n            hintContainer.innerHTML = '<span style=\"color:#6a6a8a; font-size:0.85rem;\">click to reveal</span>';\n            statusBadge.textContent = '↺ reset';\n        });\n\n        // ---------- Init Pyodide ----------\n        initPyodide();\n\n        // ensure mobile editor height\n        if (window.innerWidth < 600) {\n            editor.setSize(null, 200);\n        }\n\n        // make editor responsive on resize\n        window.addEventListener('resize', function() {\n            if (window.innerWidth < 600) {\n                editor.setSize(null, 200);\n            } else {\n                editor.setSize(null, 260);\n            }\n        });\n\n        // prefill test results as pending\n    })();\n</script>\n</body>\n</html>",
        "widgetType": "code",
        "widgetConfig": {
          "type": "code",
