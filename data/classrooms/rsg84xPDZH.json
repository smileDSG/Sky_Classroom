      "content": {
        "type": "interactive",
        "url": "",
        "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes\">\n    <title>参数交互沙盒 · FastAPI 参数实验室</title>\n    <!-- codemirror 5 (轻量, 兼容移动端) -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/codemirror.min.css\" />\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/theme/dracula.min.css\" />\n    <!-- python 语法高亮 -->\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/codemirror.min.js\"></script>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/mode/python/python.min.js\"></script>\n    <!-- pyodide (加载异步) -->\n    <script src=\"https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js\"></script>\n    <style>\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n        body {\n            background: #1e1e2e;\n            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n            color: #e0e0e0;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            padding: 16px;\n            margin: 0;\n        }\n        .widget-container {\n            max-width: 1000px;\n            width: 100%;\n            background: #2b2b3c;\n            border-radius: 32px;\n            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);\n            padding: 20px 18px;\n            transition: all 0.2s;\n        }\n        h2 {\n            font-weight: 500;\n            font-size: 1.6rem;\n            letter-spacing: 0.5px;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            margin-bottom: 8px;\n            color: #f0e9e0;\n            flex-wrap: wrap;\n        }\n        h2 small {\n            font-size: 0.9rem;\n            background: #3d3d5c;\n            padding: 4px 12px;\n            border-radius: 40px;\n            color: #b7b0d0;\n            font-weight: 400;\n        }\n        .desc {\n            background: #36364a;\n            border-radius: 24px;\n            padding: 14px 18px;\n            margin: 12px 0 18px 0;\n            border-left: 4px solid #7b6fc0;\n            font-size: 0.98rem;\n            line-height: 1.5;\n            color: #cfcde0;\n        }\n        .editor-panel {\n            background: #1e1e2f;\n            border-radius: 24px;\n            overflow: hidden;\n            border: 1px solid #3d3d5a;\n            margin-bottom: 16px;\n        }\n        .toolbar {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            background: #2a2a40;\n            padding: 8px 16px;\n            border-bottom: 1px solid #3d3d5a;\n            flex-wrap: wrap;\n            gap: 8px;\n        }\n        .lang-badge {\n            background: #4b4b72;\n            padding: 4px 14px;\n            border-radius: 40px;\n            font-size: 0.8rem;\n            font-weight: 600;\n            color: #cbc8f0;\n        }\n        .btn-group {\n            display: flex;\n            gap: 8px;\n            flex-wrap: wrap;\n        }\n        .btn {\n            background: #3b3b5a;\n            border: none;\n            padding: 8px 16px;\n            border-radius: 40px;\n            font-weight: 500;\n            font-size: 0.85rem;\n            cursor: pointer;\n            transition: 0.15s;\n            color: #e5e0f0;\n            display: inline-flex;\n            align-items: center;\n            gap: 6px;\n            box-shadow: 0 2px 3px rgba(0,0,0,0.3);\n        }\n        .btn-primary {\n            background: #6c5fc7;\n            color: white;\n        }\n        .btn-primary:active { background: #5a4ea8; }\n        .btn-outline {\n            background: transparent;\n            border: 1px solid #5d5d82;\n        }\n        .btn:disabled {\n            opacity: 0.45;\n            pointer-events: none;\n            filter: grayscale(0.6);\n        }\n        .CodeMirror {\n            height: 240px;\n            min-height: 200px;\n            font-size: 14px;\n            line-height: 1.5;\n        }\n        .output-grid {\n            display: flex;\n            flex-direction: column;\n            gap: 14px;\n            margin: 10px 0 12px 0;\n        }\n        .card {\n            background: #26263b;\n            border-radius: 24px;\n            padding: 16px 18px;\n            border: 1px solid #3f3f5b;\n        }\n        .card-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 8px;\n            font-weight: 500;\n            color: #bdb6dd;\n            flex-wrap: wrap;\n            gap: 6px;\n        }\n        .stdout-box {\n            background: #12121e;\n            border-radius: 18px;\n            padding: 12px 16px;\n            min-height: 70px;\n            font-family: 'JetBrains Mono', 'Fira Code', monospace;\n            font-size: 0.9rem;\n            white-space: pre-wrap;\n            word-break: break-word;\n            color: #dcd7f0;\n            border: 1px solid #3e3e58;\n        }\n        .test-list {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n            margin-top: 4px;\n        }\n        .test-item {\n            background: #1e1e32;\n            border-radius: 30px;\n            padding: 8px 14px 8px 18px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            flex-wrap: wrap;\n            gap: 8px;\n            border-left: 5px solid #5a5a88;\n        }\n        .test-pass {\n            border-left-color: #54d17a;\n        }\n        .test-fail {\n            border-left-color: #e45c6a;\n        }\n        .test-id {\n            font-weight: 600;\n            color: #bdb6dd;\n            margin-right: 8px;\n        }\n        .test-desc {\n            color: #b0acc5;\n            font-size: 0.9rem;\n            flex: 1;\n        }\n        .badge {\n            background: #3b3b58;\n            padding: 2px 14px;\n            border-radius: 50px;\n            font-size: 0.75rem;\n            font-weight: 600;\n        }\n        .badge-pass { background: #2c8a4a; color: white; }\n        .badge-fail { background: #b13e4e; color: white; }\n        .hints-box {\n            margin-top: 10px;\n            display: flex;\n            flex-direction: column;\n            gap: 6px;\n        }\n        .hint-chip {\n            background: #31314a;\n            padding: 6px 18px;\n            border-radius: 30px;\n            font-size: 0.9rem;\n            display: inline-block;\n            width: fit-content;\n            border: 1px solid #53537a;\n            color: #cfcbea;\n        }\n        .footer-note {\n            font-size: 0.7rem;\n            color: #7b7899;\n            text-align: right;\n            margin-top: 8px;\n        }\n        /* mobile */\n        @media (max-width: 600px) {\n            .widget-container { padding: 14px 10px; }\n            .btn { padding: 6px 14px; font-size: 0.8rem; }\n            .CodeMirror { height: 220px; }\n        }\n    </style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css\">\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js\"></script>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    const katexOptions = {\n        delimiters: [\n            {left: '\\\\[', right: '\\\\]', display: true},\n            {left: '\\\\(', right: '\\\\)', display: false},\n            {left: '$$', right: '$$', display: true},\n            {left: '$', right: '$', display: false}\n        ],\n        throwOnError: false,\n        strict: false,\n        trust: true\n    };\n\n    let renderTimeout;\n    function safeRender() {\n        if (renderTimeout) clearTimeout(renderTimeout);\n        renderTimeout = setTimeout(() => {\n            renderMathInElement(document.body, katexOptions);\n        }, 100);\n    }\n\n    renderMathInElement(document.body, katexOptions);\n\n    const observer = new MutationObserver((mutations) => {\n        let shouldRender = false;\n        mutations.forEach((mutation) => {\n            if (mutation.target &&\n                mutation.target.className &&\n                typeof mutation.target.className === 'string' &&\n                mutation.target.className.includes('katex')) {\n                return;\n            }\n            shouldRender = true;\n        });\n\n        if (shouldRender) {\n            safeRender();\n        }\n    });\n\n    observer.observe(document.body, {\n        childList: true,\n        subtree: true,\n        characterData: true\n    });\n\n    setInterval(() => {\n        const text = document.body.innerText;\n        if (text.includes('\\\\(') || text.includes('$$')) {\n            safeRender();\n        }\n    }, 2000);\n});\n</script>\n</head>\n<body>\n<div class=\"widget-container\">\n    <!-- 标题 -->\n    <h2>\n        ⚡ 参数交互沙盒\n        <small>FastAPI · Python</small>\n    </h2>\n    <div class=\"desc\">\n        🧪 在下方编辑器中编写带参数的 <strong>FastAPI 风格</strong> 函数（使用 <code>Query</code>, <code>Path</code>, <code>Body</code> 等）。\n        点击 <span class=\"badge\" style=\"background:#6c5fc7;\">▶ 模拟请求</span> 即刻解析参数定义并展示类 API 文档。\n        <span style=\"display:block; margin-top:6px; opacity:0.7;\">💡 修改参数校验 (gt, le, regex…) 观察文档变化。</span>\n    </div>\n\n    <!-- 编辑器 + 工具栏 -->\n    <div class=\"editor-panel\">\n        <div class=\"toolbar\">\n            <span class=\"lang-badge\">🐍 Python</span>\n            <div class=\"btn-group\">\n                <button class=\"btn btn-primary\" id=\"runBtn\">▶ 发送模拟请求</button>\n                <button class=\"btn btn-outline\" id=\"hintBtn\">💡 提示</button>\n            </div>\n        </div>\n        <textarea id=\"codeEditor\" name=\"code\">from typing import Optional\nfrom fastapi import Query, Path, Body\n\n# 编辑下方函数 — 参数定义会自动生成文档\nasync def get_item(\n    item_id: int = Path(..., ge=1, le=1000, description=\"商品ID\"),\n    q: Optional[str] = Query(None, max_length=20, description=\"搜索关键词\"),\n    price: float = Body(..., gt=0, le=9999.99, description=\"价格\")\n) -> dict:\n    # 模拟返回 (实际解析参数定义)\n    return {\n        \"item_id\": item_id,\n        \"q\": q,\n        \"price\": price,\n        \"message\": \"参数校验成功\"\n    }</textarea>\n    </div>\n\n    <!-- 输出区域: stdout + 测试用例 (无测试用例则显示生成的文档) -->\n    <div class=\"output-grid\">\n        <div class=\"card\">\n            <div class=\"card-header\">\n                <span>📋 API 文档 / 参数结构</span>\n                <span style=\"font-size:0.75rem; background:#3a3a55; padding:2px 12px; border-radius:30px;\">解析结果</span>\n            </div>\n            <div class=\"stdout-box\" id=\"outputDisplay\">点击「发送模拟请求」查看参数定义与校验规则</div>\n        </div>\n\n        <!-- 测试用例区域 (动态生成) 由于配置无测试用例, 但保留支架展示 -->\n        <div class=\"card\" id=\"testCard\">\n            <div class=\"card-header\">\n                <span>🧪 参数校验测试</span>\n                <span style=\"font-size:0.75rem; opacity:0.6;\">根据参数约束自动生成</span>\n            </div>\n            <div class=\"test-list\" id=\"testContainer\">\n                <div style=\"color:#8a86aa; padding:6px 0; font-size:0.9rem;\">⏳ 运行代码后显示测试用例</div>\n            </div>\n        </div>\n\n        <!-- 提示区域 -->\n        <div class=\"card\" id=\"hintCard\">\n            <div class=\"card-header\">\n                <span>🧠 提示</span>\n                <button class=\"btn btn-outline\" id=\"hintResetBtn\" style=\"padding:2px 12px; font-size:0.7rem;\">重置</button>\n            </div>\n            <div class=\"hints-box\" id=\"hintContainer\">\n                <span class=\"hint-chip\" style=\"opacity:0.7;\">点击 💡 显示提示</span>\n            </div>\n        </div>\n    </div>\n    <div class=\"footer-note\">⚡ 参数沙盒 · 编辑即文档</div>\n</div>\n\n<!-- widget config (嵌入) -->\n<script type=\"application/json\" id=\"widget-config\">\n    {\n        \"type\": \"code\",\n        \"language\": \"python\",\n        \"description\": \"通过一个可交互的编辑器，让学习者动手编写和测试不同的参数定义。\",\n        \"starterCode\": \"from typing import Optional\\nfrom fastapi import Query, Path, Body\\n\\nasync def get_item(\\n    item_id: int = Path(..., ge=1, le=1000, description=\\\"商品ID\\\"),\\n    q: Optional[str] = Query(None, max_length=20, description=\\\"搜索关键词\\\"),\\n    price: float = Body(..., gt=0, le=9999.99, description=\\\"价格\\\")\\n) -> dict:\\n    return {\\\"item_id\\\": item_id, \\\"q\\\": q, \\\"price\\\": price, \\\"message\\\": \\\"参数校验成功\\\"}\",\n        \"testCases\": [],\n        \"hints\": [\"使用 Path(..., ge=1) 限制路径参数最小值\", \"Query(None, max_length=20) 增加字符串校验\", \"Body(..., gt=0, le=9999.99) 约束数值范围\"],\n        \"solution\": \"见编辑器示例\"\n    }\n</script>\n\n<script>\n    (function() {\n        // ---------- 初始化 codemirror ----------\n        const textarea = document.getElementById('codeEditor');\n        const editor = CodeMirror.fromTextArea(textarea, {\n            mode: 'python',\n            theme: 'dracula',\n            lineNumbers: true,\n            indentUnit: 4,\n            tabSize: 4,\n            indentWithTabs: false,\n            lineWrapping: true,\n            extraKeys: {\"Ctrl-Enter\": runCode, \"Cmd-Enter\": runCode},\n            viewportMargin: Infinity\n        });\n        editor.setSize(null, 240);\n\n        // DOM 元素\n        const runBtn = document.getElementById('runBtn');\n        const hintBtn = document.getElementById('hintBtn');\n        const hintResetBtn = document.getElementById('hintResetBtn');\n        const outputDisplay = document.getElementById('outputDisplay');\n        const testContainer = document.getElementById('testContainer');\n        const hintContainer = document.getElementById('hintContainer');\n\n        // 提示列表 (从 widget-config 读取)\n        const configScript = document.getElementById('widget-config');\n        let hintsArray = [\"使用 Path(..., ge=1) 限制路径参数最小值\", \"Query(None, max_length=20) 增加字符串校验\", \"Body(..., gt=0, le=9999.99) 约束数值范围\"];\n        try {\n            const cfg = JSON.parse(configScript.textContent);\n            if (cfg.hints && Array.isArray(cfg.hints) && cfg.hints.length) {\n                hintsArray = cfg.hints;\n            }\n        } catch (e) {}\n\n        let hintIndex = 0;\n        function renderHints() {\n            hintContainer.innerHTML = '';\n            if (hintIndex === 0) {\n                hintContainer.innerHTML = '<span class=\"hint-chip\" style=\"opacity:0.6;\">💡 点击提示按钮显示</span>';\n                return;\n            }\n            for (let i = 0; i < Math.min(hintIndex, hintsArray.length); i++) {\n                const chip = document.createElement('span');\n                chip.className = 'hint-chip';\n                chip.textContent = '🔹 ' + hintsArray[i];\n                hintContainer.appendChild(chip);\n            }\n            if (hintIndex >= hintsArray.length) {\n                const done = document.createElement('span');\n                done.className = 'hint-chip';\n                done.textContent = '✅ 所有提示已显示';\n                done.style.background = '#3a5a4a';\n                hintContainer.appendChild(done);\n            }\n        }\n        renderHints();\n\n        hintBtn.addEventListener('click', function() {\n            if (hintIndex < hintsArray.length) hintIndex++;\n            renderHints();\n        });\n        hintResetBtn.addEventListener('click', function() {\n            hintIndex = 0;\n            renderHints();\n        });\n\n        // ---------- pyodide 异步初始化 ----------\n        let pyodide = null;\n        let pyodideReady = false;\n\n        async function initPyodide() {\n            try {\n                outputDisplay.textContent = '🔄 正在加载 Python 引擎 (Pyodide) ...';\n                runBtn.disabled = true;\n                // 安装额外包 (fastapi 在 pyodide 中不可用, 但是我们模拟解析)\n                // 实际并不需要 fastapi 包, 我们只是解析文本, 因此不用加载包\n                pyodide = await loadPyodide({\n                    indexURL: \"https://cdn.jsdelivr.net/pyodide/v0.25.0/full/\"\n                });\n                // 预热: 导入模拟解析模块 (内嵌 python 解析代码)\n                await pyodide.runPythonAsync(`\n                    import sys, io, json\n\n                    # 模拟解析函数定义, 提取参数和约束 (基于 fastapi 风格)\n                    def extract_params(code_str):\n                        \"\"\"\n                        简易解析: 寻找 async def 函数, 提取参数及其 default (如 Query, Path, Body)\n                        返回可读文档结构\n                        \"\"\"\n                        # 基本解析: 找函数定义行\n                        import re\n                        lines = code_str.split('\\\\n')\n                        params_info = []\n                        in_func = False\n                        func_name = \"unknown\"\n                        for line in lines:\n                            # 检测函数定义\n                            m = re.search(r'async\\\\s+def\\\\s+(\\\\w+)\\\\s*\\\\(', line)\n                            if m:\n                                func_name = m.group(1)\n                                in_func = True\n                                continue\n                            if in_func:\n                                if line.strip().startswith(')') or line.strip().startswith('->'):\n                                    break\n                                # 匹配参数:  param: type = Default(...)\n                                param_match = re.match(r'\\\\s*(\\\\w+)\\\\s*:\\\\s*(\\\\w+)\\\\s*=\\\\s*(\\\\w+)\\\\((.+)\\\\)\\\\s*', line)\n                                if param_match:\n                                    pname = param_match.group(1)\n                                    ptype = param_match.group(2)\n                                    pdefault = param_match.group(3)\n                                    inside = param_match.group(4)\n                                    # 提取约束\n                                    constraints = {}\n                                    # 查找 ge, le, gt, lt, max_length, regex, description\n                                    for attr in ['ge','le','gt','lt','max_length','regex','description']:\n                                        vm = re.search(attr+'\\\\s*=\\\\s*([^,)]+)', inside)\n                                        if vm:\n                                            val = vm.group(1).strip().strip(\"'\\\\\\\"\")\n                                            constraints[attr] = val\n                                    params_info.append({\n                                        'name': pname,\n                                        'type': ptype,\n                                        'default_type': pdefault,\n                                        'constraints': constraints,\n                                        'raw': line.strip()\n                                    })\n                            # 简单: 遇到return通常跳出\n                        return {\n                            'function': func_name,\n                            'parameters': params_info,\n                            'parsed': True\n                        }\n                `);\n                pyodideReady = true;\n                runBtn.disabled = false;\n                outputDisplay.textContent = '✅ Python 引擎就绪。编辑代码后点击「发送模拟请求」';\n            } catch (err) {\n                console.error(err);\n                outputDisplay.textContent = '❌ Python 引擎加载失败: ' + err.message;\n                runBtn.disabled = false;\n            }\n        }\n\n        // 异步运行函数\n        async function runCode() {\n            if (!pyodideReady || !pyodide) {\n                outputDisplay.textContent = '⏳ Python 引擎尚未完全加载，请稍候 ...';\n                return;\n            }\n            const code = editor.getValue();\n            outputDisplay.textContent = '⏳ 解析参数定义 ...';\n            testContainer.innerHTML = '<div style=\"color:#8a86aa; padding:6px 0;\">⏳ 校验中...</div>';\n\n            try {\n                // 使用正确的 stdout 捕获 (关键)\n                await pyodide.runPythonAsync(`\n                    import sys, io\n                    sys.stdout = io.StringIO()\n                `);\n                // 将代码传入 python 解析\n                const codeSafe = code.replace(/\\\\/g, '\\\\\\\\').replace(/`/g, '\\\\`').replace(/\\$/g, '\\\\$');\n                const result = await pyodide.runPythonAsync(`\n                    import json, sys\n                    # 使用提取函数\n                    parsed = extract_params('''${codeSafe}''')\n                    sys.stdout.write(json.dumps(parsed, ensure_ascii=False, indent=2))\n                `);\n                const rawOutput = pyodide.runPython('sys.stdout.getvalue()');\n                // 解析 JSON\n                let parsed = null;\n                try {\n                    parsed = JSON.parse(rawOutput);\n                } catch (e) {\n                    outputDisplay.textContent = '⚠️ 解析异常: ' + rawOutput;\n                    return;\n                }\n                // 格式化显示\n                if (parsed && parsed.parameters && parsed.parameters.length > 0) {\n                    let html = `📦 函数: <strong>${parsed.function}</strong>  (参数数: ${parsed.parameters.length})\\n\\n`;\n                    parsed.parameters.forEach(p => {\n                        html += `🔹 ${p.name}: ${p.type}`;\n                        if (p.default_type) html += ` = ${p.default_type}(...)`;\n                        html += `\\n`;\n                        const c = p.constraints;\n                        const parts = [];\n                        if (c.ge !== undefined) parts.push(`ge=${c.ge}`);\n                        if (c.le !== undefined) parts.push(`le=${c.le}`);\n                        if (c.gt !== undefined) parts.push(`gt=${c.gt}`);\n                        if (c.lt !== undefined) parts.push(`lt=${c.lt}`);\n                        if (c.max_length !== undefined) parts.push(`max_length=${c.max_length}`);\n                        if (c.regex !== undefined) parts.push(`regex=${c.regex}`);\n                        if (c.description !== undefined) parts.push(`desc=\"${c.description}\"`);\n                        if (parts.length) html += `   限制: ${parts.join(', ')}\\n`;\n                        else html += `   无显式约束\\n`;\n                    });\n                    outputDisplay.textContent = html;\n\n                    // 动态生成测试用例 (基于约束展示)\n                    testContainer.innerHTML = '';\n                    if (parsed.parameters.length === 0) {\n                        testContainer.innerHTML = '<div style=\"color:#8a86aa;\">没有参数约束测试</div>';\n                    } else {\n                        parsed.parameters.forEach((p, idx) => {\n                            const div = document.createElement('div');\n                            div.className = 'test-item';\n                            const constraints = p.constraints;\n                            let info = `${p.name} (${p.type})`;\n                            if (Object.keys(constraints).length > 0) {\n                                info += ' · 约束: ' + Object.keys(constraints).map(k => `${k}=${constraints[k]}`).join(' ');\n                                div.classList.add('test-pass');\n                            } else {\n                                info += ' · 无约束';\n                                div.classList.add('test-fail');\n                            }\n                            div.innerHTML = `\n                                <span><span class=\"test-id\">#${idx+1}</span> <span class=\"test-desc\">${info}</span></span>\n                                <span class=\"badge ${Object.keys(constraints).length > 0 ? 'badge-pass' : 'badge-fail'}\">${Object.keys(constraints).length > 0 ? '✓ 校验' : '⚡ 自由'}</span>\n                            `;\n                            testContainer.appendChild(div);\n                        });\n                    }\n                } else {\n                    outputDisplay.textContent = '⚠️ 未能解析出参数。请确认函数使用 async def 并包含 Path/Query/Body 参数。';\n                    testContainer.innerHTML = '<div style=\"color:#b36;\">未检测到参数定义</div>';\n                }\n\n            } catch (err) {\n                outputDisplay.textContent = '❌ 执行错误: ' + err.message;\n                testContainer.innerHTML = '<div style=\"color:#b36;\">代码执行异常</div>';\n            }\n        }\n\n        // 绑定运行按钮\n        runBtn.addEventListener('click', runCode);\n        // 启动 Pyodide\n        initPyodide();\n\n        // 自适应滚动\n        window.addEventListener('resize', () => {\n            const width = window.innerWidth;\n            if (width < 600) {\n                editor.setSize(null, 200);\n            } else {\n                editor.setSize(null, 240);\n            }\n        });\n\n    })();\n</script>\n</body>\n</html>",
