            {
              "id": "el_LcZez4Fs",
              "type": "text",
              "left": 60,
              "top": 50,
              "width": 880,
              "height": 55,
              "rotate": 0,
              "content": "<p><strong><span style=\"font-size:24px;color:#1e3a5f;\">图像平移与最值问题</span></strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1e3a5f",
