              "#ffc000",
              "#4472c4"
            ],
            "fontColor": "#333333",
            "fontName": "Microsoft YaHei"
          },
          "elements": [
            {
              "id": "el_yZtm9ChM",
              "type": "text",
              "left": 60,
              "top": 50,
              "width": 880,
              "height": 55,
              "rotate": 0,
              "content": "<p><strong><span style=\"font-size:24px;color:#1e3a5f;\">求二次函数解析式（待定系数法）</span></strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#1e3a5f",
              "lineHeight": 1.4,
              "paragraphSpace": 0,
              "textType": "title"
            },
            {
              "id": "el_DBNYpnR2",
              "type": "text",
              "left": 60,
              "top": 120,
              "width": 880,
              "height": 200,
              "rotate": 0,
              "content": "<p>例题：### 例题 2（交点式）</p><p><strong>题目</strong>：抛物线与 $x$ 轴交于 $(-1, 0)$ 和 $(3, 0)$，且经过点 $(0, -3)$，求解析式。</p><p><strong>【分析】</strong>：已知与 $x$ 轴交点，设交点式 $y = a(x - x_1)(x - x_2)$。</p><p><strong>【解答】</strong>：</p><p>1. 设 $y = a(x + 1)(x - 3)$（注意 $x_1 = -1$，$x_2 = 3$）。</p><p>2. 代入点 $(0, -3)$ 得：$a \\cdot 1 \\cdot (-3) = -3 \\Rightarrow -3a = -3 \\Rightarrow a = 1$。</p><p>3. 所以解析式为 $y = (x+1)(x-3) = x^2 - 2x - 3$。</p><p><strong>易错点</strong>：① 交点式中的符号：$x_1 = -1$ 时因式为 $(x+1)$ 而不是 $(x-1)$；② 交点式不能用于与 $x$ 轴只有一个交点或没有交点的情况，此时应使用顶点式或一般式。</p><p><strong>变式</strong>：若抛物线与 $x$ 轴只有一个交点 $(2, 0)$ 且经过 $(0, 4)$，则设顶点式 $y = a(x-2)^2 + 0$，代入得 $a = 1$，解析式为 $y = (x-2)^2$。</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#334155",
              "lineHeight": 1.5,
              "paragraphSpace": 4,
              "fill": "#f0f9ff",
              "textType": "content"
            }
          ],
          "background": {
            "type": "solid",
            "color": "#ffffff"
          },
          "type": "content"
        }
      },
