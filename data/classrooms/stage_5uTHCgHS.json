      "order": 9,
      "content": {
        "type": "slide",
        "canvas": {
          "id": "slide_2YDp5Fnt",
          "viewportSize": 1000,
          "viewportRatio": 0.5625,
          "theme": {
            "backgroundColor": "#ffffff",
            "themeColors": [
              "#5b9bd5",
              "#ed7d31",
