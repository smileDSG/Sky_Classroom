{
  "courseId": "ai-intro-2026",
  "version": "v0.1.0",
  "nodes": [
    {
      "id": "ai-definition",
      "name": "人工智能定义",
      "chapter": "01-ai-overview",
      "difficulty": 1,
      "prerequisites": [],
      "masteryCriteria": ["能说明 AI 的研究对象", "能举出至少三个 AI 应用场景"],
      "commonMisconceptions": ["把 AI 等同于单个模型或软件"]
    },
    {
      "id": "ai-ml-dl-llm-agent",
      "name": "AI、ML、DL、LLM、Agent 关系",
      "chapter": "01-ai-overview",
      "difficulty": 2,
      "prerequisites": ["ai-definition"],
      "masteryCriteria": ["能画出五个概念的层次关系", "能解释智能体与普通问答模型的差异"],
      "commonMisconceptions": ["认为大模型就是全部人工智能"]
    },
    {
      "id": "ai-system-elements",
      "name": "AI 系统四要素",
      "chapter": "01-ai-overview",
      "difficulty": 2,
      "prerequisites": ["ai-definition"],
      "masteryCriteria": ["能从任务、数据、模型、评价四方面分析 AI 系统"],
      "commonMisconceptions": ["只关注模型而忽视数据和评价"]
    },
    {
      "id": "trustworthy-ai-intro",
      "name": "可信 AI 入门",
      "chapter": "01-ai-overview",
      "difficulty": 2,
      "prerequisites": ["ai-system-elements"],
      "masteryCriteria": ["能说明可信 AI 为什么需要来源、评价和安全约束"],
      "commonMisconceptions": ["认为输出流畅就等于可靠"]
    },
    {
      "id": "state-space",
      "name": "状态空间",
      "chapter": "02-search-and-problem-solving",
      "difficulty": 2,
      "prerequisites": ["ai-definition"],
      "masteryCriteria": ["能用状态、动作、目标描述搜索问题"],
      "commonMisconceptions": ["把状态和动作混为一谈"]
    },
    {
      "id": "bfs-dfs",
      "name": "BFS 与 DFS",
      "chapter": "02-search-and-problem-solving",
      "difficulty": 2,
      "prerequisites": ["state-space"],
      "masteryCriteria": ["能比较 BFS 与 DFS 的扩展顺序和适用场景"],
      "commonMisconceptions": ["认为 DFS 一定比 BFS 快"]
    },
    {
      "id": "heuristic-search",
      "name": "启发式搜索",
      "chapter": "02-search-and-problem-solving",
      "difficulty": 3,
      "prerequisites": ["state-space"],
      "masteryCriteria": ["能解释启发函数的作用", "能设计简单启发函数"],
      "commonMisconceptions": ["认为启发函数越复杂越好"]
    },
    {
      "id": "a-star",
      "name": "A* 搜索",
      "chapter": "02-search-and-problem-solving",
      "difficulty": 3,
      "prerequisites": ["heuristic-search"],
      "masteryCriteria": ["能解释 f(n)=g(n)+h(n)", "能说明 A* 最优性的条件"],
      "commonMisconceptions": ["认为 A* 在任何启发函数下都最优"]
    },
    {
      "id": "propositional-logic",
      "name": "命题逻辑",
      "chapter": "03-knowledge-representation",
      "difficulty": 2,
      "prerequisites": ["ai-definition"],
      "masteryCriteria": ["能用命题和连接词表达简单规则"],
      "commonMisconceptions": ["把自然语言句子直接当作机器可推理知识"]
    },
    {
      "id": "production-rules",
      "name": "产生式规则",
      "chapter": "03-knowledge-representation",
      "difficulty": 2,
      "prerequisites": ["propositional-logic"],
      "masteryCriteria": ["能写出 IF-THEN 形式规则"],
      "commonMisconceptions": ["认为规则系统可以覆盖所有模糊场景"]
    },
    {
      "id": "ontology",
      "name": "本体与概念层级",
      "chapter": "03-knowledge-representation",
      "difficulty": 3,
      "prerequisites": ["production-rules"],
      "masteryCriteria": ["能说明类、实例和关系的差异"],
      "commonMisconceptions": ["把本体等同于普通分类目录"]
    },
    {
      "id": "knowledge-graph",
      "name": "知识图谱",
      "chapter": "03-knowledge-representation",
      "difficulty": 3,
      "prerequisites": ["ontology"],
      "masteryCriteria": ["能用节点和边表达课程知识点关系"],
      "commonMisconceptions": ["认为知识图谱只是展示用图片"]
    },
    {
      "id": "ml-workflow",
      "name": "机器学习流程",
      "chapter": "04-machine-learning-basics",
      "difficulty": 2,
      "prerequisites": ["ai-ml-dl-llm-agent"],
      "masteryCriteria": ["能列出数据、特征、训练、评价、部署流程"],
      "commonMisconceptions": ["直接训练模型而不做数据和评价设计"]
    },
    {
      "id": "train-validation-test",
      "name": "训练集、验证集、测试集",
      "chapter": "04-machine-learning-basics",
      "difficulty": 2,
      "prerequisites": ["ml-workflow"],
      "masteryCriteria": ["能说明三类数据集的不同用途"],
      "commonMisconceptions": ["反复用测试集调参"]
    },
    {
      "id": "overfitting-generalization",
      "name": "过拟合与泛化能力",
      "chapter": "04-machine-learning-basics",
      "difficulty": 3,
      "prerequisites": ["train-validation-test"],
      "masteryCriteria": ["能根据训练/测试表现判断过拟合", "能提出缓解策略"],
      "commonMisconceptions": ["认为训练集准确率越高模型越好"]
    },
    {
      "id": "classification-metrics",
      "name": "分类评价指标",
      "chapter": "04-machine-learning-basics",
      "difficulty": 3,
      "prerequisites": ["train-validation-test"],
      "masteryCriteria": ["能解释准确率、精确率、召回率和 F1"],
      "commonMisconceptions": ["类别不平衡时仍只看准确率"]
    },
    {
      "id": "supervised-learning",
      "name": "监督学习",
      "chapter": "05-supervised-learning",
      "difficulty": 2,
      "prerequisites": ["ml-workflow"],
      "masteryCriteria": ["能区分监督学习和无监督学习"],
      "commonMisconceptions": ["认为所有学习任务都有标签"]
    },
    {
      "id": "classification-regression",
      "name": "分类与回归",
      "chapter": "05-supervised-learning",
      "difficulty": 2,
      "prerequisites": ["supervised-learning"],
      "masteryCriteria": ["能根据标签类型判断分类或回归"],
      "commonMisconceptions": ["看到逻辑回归就误认为是回归任务"]
    },
    {
      "id": "knn",
      "name": "KNN",
      "chapter": "05-supervised-learning",
      "difficulty": 2,
      "prerequisites": ["classification-regression"],
      "masteryCriteria": ["能说明 K 值、距离度量和特征缩放的影响"],
      "commonMisconceptions": ["忽略特征尺度对距离的影响"]
    },
    {
      "id": "decision-tree",
      "name": "决策树",
      "chapter": "05-supervised-learning",
      "difficulty": 3,
      "prerequisites": ["classification-regression", "overfitting-generalization"],
      "masteryCriteria": ["能解释树的划分规则和过拟合风险"],
      "commonMisconceptions": ["认为决策树越深越好"]
    },
    {
      "id": "neuron-activation",
      "name": "神经元与激活函数",
      "chapter": "06-neural-networks",
      "difficulty": 2,
      "prerequisites": ["classification-regression"],
      "masteryCriteria": ["能解释加权求和和非线性激活的作用"],
      "commonMisconceptions": ["认为神经元等同于生物神经元"]
    },
    {
      "id": "forward-loss",
      "name": "前向传播与损失函数",
      "chapter": "06-neural-networks",
      "difficulty": 2,
      "prerequisites": ["neuron-activation"],
      "masteryCriteria": ["能说明预测值如何通过损失函数被评价"],
      "commonMisconceptions": ["只看输出不理解损失含义"]
    },
    {
      "id": "backprop-gradient",
      "name": "反向传播与梯度下降",
      "chapter": "06-neural-networks",
      "difficulty": 4,
      "prerequisites": ["forward-loss"],
      "masteryCriteria": ["能用直觉解释梯度如何指导参数更新"],
      "commonMisconceptions": ["把反向传播理解为反向运行网络"]
    },
    {
      "id": "cnn",
      "name": "卷积神经网络",
      "chapter": "06-neural-networks",
      "difficulty": 3,
      "prerequisites": ["neuron-activation"],
      "masteryCriteria": ["能说明卷积核、池化和局部特征"],
      "commonMisconceptions": ["认为 CNN 只能记忆图片像素"]
    },
    {
      "id": "nlp-tasks",
      "name": "NLP 任务",
      "chapter": "07-natural-language-processing",
      "difficulty": 2,
      "prerequisites": ["ai-ml-dl-llm-agent"],
      "masteryCriteria": ["能举出文本分类、问答、摘要等任务"],
      "commonMisconceptions": ["把 NLP 仅理解为聊天"]
    },
    {
      "id": "text-representation",
      "name": "文本表示",
      "chapter": "07-natural-language-processing",
      "difficulty": 2,
      "prerequisites": ["nlp-tasks"],
      "masteryCriteria": ["能比较词袋模型和词向量"],
      "commonMisconceptions": ["认为词频越高语义越重要"]
    },
    {
      "id": "attention",
      "name": "注意力机制",
      "chapter": "07-natural-language-processing",
      "difficulty": 4,
      "prerequisites": ["text-representation"],
      "masteryCriteria": ["能解释模型为什么需要关注不同上下文位置"],
      "commonMisconceptions": ["把注意力权重直接等同于因果解释"]
    },
    {
      "id": "transformer",
      "name": "Transformer",
      "chapter": "07-natural-language-processing",
      "difficulty": 4,
      "prerequisites": ["attention"],
      "masteryCriteria": ["能说明自注意力和并行训练优势"],
      "commonMisconceptions": ["认为 Transformer 只用于文本"]
    },
    {
      "id": "cv-tasks",
      "name": "计算机视觉任务",
      "chapter": "08-computer-vision",
      "difficulty": 2,
      "prerequisites": ["cnn"],
      "masteryCriteria": ["能区分分类、检测、分割和生成"],
      "commonMisconceptions": ["把所有视觉任务都当成分类"]
    },
    {
      "id": "image-features",
      "name": "图像特征",
      "chapter": "08-computer-vision",
      "difficulty": 3,
      "prerequisites": ["cv-tasks"],
      "masteryCriteria": ["能说明边缘、纹理、形状等层级特征"],
      "commonMisconceptions": ["认为像素矩阵天然包含语义"]
    },
    {
      "id": "data-augmentation",
      "name": "数据增强",
      "chapter": "08-computer-vision",
      "difficulty": 2,
      "prerequisites": ["image-features", "overfitting-generalization"],
      "masteryCriteria": ["能说明翻转、裁剪、颜色扰动的作用"],
      "commonMisconceptions": ["认为增强越多越一定好"]
    },
    {
      "id": "transfer-learning",
      "name": "迁移学习",
      "chapter": "08-computer-vision",
      "difficulty": 3,
      "prerequisites": ["cnn"],
      "masteryCriteria": ["能说明预训练模型和针对任务进一步调整的意义"],
      "commonMisconceptions": ["认为迁移学习不需要关注新数据分布"]
    },
    {
      "id": "rl-agent-env",
      "name": "强化学习智能体与环境",
      "chapter": "09-reinforcement-learning",
      "difficulty": 2,
      "prerequisites": ["ai-ml-dl-llm-agent"],
      "masteryCriteria": ["能说明状态、动作、奖励和策略"],
      "commonMisconceptions": ["认为强化学习有每步标准答案"]
    },
    {
      "id": "mdp",
      "name": "马尔可夫决策过程",
      "chapter": "09-reinforcement-learning",
      "difficulty": 3,
      "prerequisites": ["rl-agent-env"],
      "masteryCriteria": ["能列出 MDP 的组成要素"],
      "commonMisconceptions": ["忽略转移概率和奖励函数"]
    },
    {
      "id": "q-learning",
      "name": "Q-learning",
      "chapter": "09-reinforcement-learning",
      "difficulty": 4,
      "prerequisites": ["mdp"],
      "masteryCriteria": ["能解释 Q 值更新的目标"],
      "commonMisconceptions": ["把 Q 值当成立即奖励"]
    },
    {
      "id": "exploration-exploitation",
      "name": "探索与利用",
      "chapter": "09-reinforcement-learning",
      "difficulty": 3,
      "prerequisites": ["rl-agent-env"],
      "masteryCriteria": ["能解释 epsilon-greedy 的直觉"],
      "commonMisconceptions": ["认为总选当前最优动作一定最好"]
    },
