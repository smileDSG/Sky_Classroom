# =============================================================================
# 智眸无界 — AutoDL 部署用精简环境变量模板
# 复制成 .env.local 后按需填写：cp scripts/autodl/env.autodl.template .env.local
#
# 说明：这里只留部署真正要动的项。完整可选配置见项目根目录 .env.example
# =============================================================================

# --- 访问口令（公网暴露时强烈建议设置）--------------------------------------
# 不设的话任何人拿到地址都能进
ACCESS_CODE=改成你自己的口令

# --- 大模型（至少填一个，否则"生成课程"按钮用不了）--------------------------
# 国内几家便宜好用的，挑一个填即可：

# DeepSeek
DEEPSEEK_API_KEY=
# 月之暗面 Kimi
KIMI_API_KEY=
# 智谱 GLM
GLM_API_KEY=
# 阿里通义千问
QWEN_API_KEY=

# --- 默认模型（省得界面上手动选）--------------------------------------------
# 格式：provider:model-id，填了哪个 key 就用哪个前缀
#   DeepSeek  -> deepseek:deepseek-chat
#   Kimi      -> kimi:moonshot-v1-8k
#   GLM       -> glm:glm-4-flash
#   千问      -> qwen:qwen-plus
DEFAULT_MODEL=deepseek:deepseek-chat

# --- 以下保持默认即可 -------------------------------------------------------
# 生产环境拒绝内存态用户数据，这里显式关掉
ALLOW_IN_MEMORY_STORAGE=false
# 自建模型（Ollama 等）才需要开
# ALLOW_LOCAL_NETWORKS=true
# 若"自定义服务"用 iframe 嵌套导致页面被拦，把你的域名填这里
# ALLOWED_FRAME_ANCESTORS=https://u39-xxx.seetacloud.com
